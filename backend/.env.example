# ════════════════════════════════════════════════════════════════════════════════
# Music Knowledge & Discovery Agent — Environment Variables
# ════════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — it is already in .gitignore.
# ════════════════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="Music Knowledge & Discovery Agent"
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-to-a-random-32-char-string

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=music_agent
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:your-postgres-password@127.0.0.1:5432/music_agent
SYNC_DATABASE_URL=postgresql://postgres:your-postgres-password@127.0.0.1:5432/music_agent

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001
CHROMA_PERSIST_DIR=./data/chroma_store

# ════════════════════════════════════════════════════════════════════════════════
# LLM API Keys — provide keys only for the providers you use
# ════════════════════════════════════════════════════════════════════════════════

# Groq  (free tier available) — https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google AI (Gemini)          — https://aistudio.google.com
GOOGLE_API_KEY=your_google_api_key_here

# Anthropic (Claude)          — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# OpenAI (GPT-4o, etc.)       — https://platform.openai.com
OPENAI_API_KEY=sk-your_openai_key_here

# DeepSeek (DeepSeek-Coder)   — https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_key_here

# ════════════════════════════════════════════════════════════════════════════════
# Per-Role Model Selection (swap any model without touching code)
# Format: "<provider>/<model-name>"  — LiteLLM resolves the provider automatically
# ════════════════════════════════════════════════════════════════════════════════

# 1. Supervisor — ultra-low latency classification (~100ms on Groq LPU)
#    Alternatives: groq/llama-3.1-8b-instant  |  groq/gemma2-9b-it
SUPERVISOR_MODEL=groq/llama-3.3-70b-versatile

# 2. Text-to-SQL — high SQL accuracy, strict schema adherence
#    Alternatives: anthropic/claude-3-5-haiku-20241022  |  deepseek/deepseek-coder
SQL_MODEL=groq/llama-3.3-70b-versatile

# 3. RAG Generator — large context window (1M tokens), natural synthesis
#    Alternatives: anthropic/claude-3-5-sonnet-20241022  |  openai/gpt-4o
RAG_MODEL=gemini/gemini-1.5-flash

# 4. Reviewer / Judge — deep reasoning, hallucination detection
#    Alternatives: openai/gpt-4o  |  anthropic/claude-3-5-sonnet-20241022
REVIEWER_MODEL=groq/llama-3.3-70b-versatile

# 5. Memory Extractor — simple JSON extraction, background task (cheapest model)
#    Alternatives: openai/gpt-4o-mini  |  groq/gemma2-9b-it
MEMORY_MODEL=groq/llama-3.1-8b-instant

# 6. Chat Agent — casual conversation
CHAT_MODEL=groq/llama-3.3-70b-versatile

# 7. Creative Agent — songwriting / lyrics / poetry
CREATIVE_MODEL=groq/llama-3.3-70b-versatile

# 8. Tool Agent — function calling / live API orchestration
TOOL_MODEL=groq/llama-3.3-70b-versatile

# ── Guardrails ────────────────────────────────────────────────────────────────
MAX_LYRIC_CHARS=50
CONFIDENCE_THRESHOLD=0.6

# ── Spotify API ───────────────────────────────────────────────────────────────
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth/spotify/callback

# ── MusicBrainz ───────────────────────────────────────────────────────────────
MUSICBRAINZ_APP_NAME=MusicKnowledgeAgent
MUSICBRAINZ_VERSION=1.0
MUSICBRAINZ_CONTACT=your-email@example.com

# ── Tavily Web Search ─────────────────────────────────────────────────────────
# Get a free key at https://tavily.com
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# ── LangSmith Observability (optional, free tier) ─────────────────────────────
# Sign up at https://smith.langchain.com — leave blank to disable tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=lsv2_pt_your_langsmith_key_here
LANGCHAIN_PROJECT=music-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
