# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="Music Knowledge & Discovery Agent"
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=your-super-secret-key-change-in-production

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=music_agent
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/music_agent
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/music_agent

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIR=./data/chroma_store

# ── LLM (Google Gemini) ────────────────────────────────────────────────────────
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_PRO_MODEL=gemini-1.5-pro

# ── Spotify ───────────────────────────────────────────────────────────────────
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=http://localhost:8000/auth/spotify/callback

# ── MusicBrainz ───────────────────────────────────────────────────────────────
MUSICBRAINZ_APP_NAME=MusicKnowledgeAgent
MUSICBRAINZ_VERSION=1.0
MUSICBRAINZ_CONTACT=your-email@example.com

# ── Guardrails ─────────────────────────────────────────────────────────────────
MAX_LYRIC_CHARS=50
CONFIDENCE_THRESHOLD=0.6
